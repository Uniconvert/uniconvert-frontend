# 아직 연결하지 않은 도메인은 Mock API를 사용합니다.
VITE_USE_MOCK_API=true

# true로 바꾸면 전체 Mock 모드에서도 인증만 실제 서버에 연결합니다.
VITE_USE_REAL_AUTH_API=false

# true로 바꾸면 전체 Mock 모드에서도 온보딩 저장·조회만 실제 서버에 연결합니다.
# 실제 토큰이 필요하므로 VITE_USE_REAL_AUTH_API=true와 함께 사용해야 합니다.
VITE_USE_REAL_ONBOARDING_API=false

# true로 바꾸면 전체 Mock 모드에서도 지출 조회·등록·CSV 업로드를 실제 서버에 연결합니다.
# 실제 토큰이 필요하므로 VITE_USE_REAL_AUTH_API=true와 함께 사용해야 합니다.
VITE_USE_REAL_EXPENSE_API=false

# 홈의 월 예산 조회·수정을 실제 서버에 연결합니다.
VITE_USE_REAL_BUDGET_API=false

# 지출 카테고리 목록을 실제 서버에 연결합니다.
VITE_USE_REAL_CATEGORY_API=false

# 온보딩 통화 목록을 실제 서버에서 조회합니다.
VITE_USE_REAL_CURRENCY_API=false

# 환율 조회·계산을 실제 서버에 연결합니다.
VITE_USE_REAL_EXCHANGE_API=false

# Pots 조회·생성·수정·배정·보관을 실제 서버에 연결합니다.
VITE_USE_REAL_POTS_API=false

# 리포트 요약·카테고리·즉시 이메일 발송을 실제 서버에 연결합니다.
VITE_USE_REAL_REPORT_API=false

# 실제 API에는 /api/v1 접두사가 없습니다.
VITE_API_BASE_URL=https://api.uniconvert.dev

# Google Cloud Console에서 발급한 OAuth 2.0 웹 클라이언트 ID
VITE_GOOGLE_CLIENT_ID=

# 백엔드가 Google ID 토큰을 받는 경로
VITE_GOOGLE_AUTH_PATH=/auth/social/google
